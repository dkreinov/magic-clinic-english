#!/bin/sh
# Refuse a push that looks like it discloses the learner's vocabulary.
#
# Installed by:  git config core.hooksPath scripts/hooks
# (so it is version-controlled and cannot be lost with .git/, unlike a hook copied
# into .git/hooks -- which is exactly how "we'll remember" controls disappear.)
#
# git hands us, on stdin, one line per ref being pushed:
#     <local ref> <local sha> <remote ref> <remote sha>
# The remote sha is what GitHub already has, so <remote>..<local> is EXACTLY the
# set of commits this push would publish. That range is the thing to check -- not
# the working tree, which was already clean during the 2026-08-03 incident.

if [ "$SKIP_RECORD_PRIVACY" = "1" ]; then
  echo "pre-push: record-privacy check SKIPPED by SKIP_RECORD_PRIVACY=1" >&2
  exit 0
fi

ZERO="0000000000000000000000000000000000000000"
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue          # a branch deletion publishes nothing

  if [ "$remote_sha" = "$ZERO" ]; then
    # A brand-new branch: the remote has nothing, so everything not already on some
    # other remote branch is new. Checking the whole ref is the safe reading.
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  node scripts/check-record-privacy.mjs "$range" || status=1
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: REFUSED. Nothing of hers is public today." >&2
  exit 1
fi

exit 0
